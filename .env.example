# WhatsApp Bot Configuration

# Bot Settings
CLIENT_NAME=SPG_Monitoring_Bot
BOT_NUMBER=
PORT=3000

# Supervisor/Admin Configuration
SUPERVISOR_PHONE=

# Supabase Configuration (Optional - untuk database cloud)
