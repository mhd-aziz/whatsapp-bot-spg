# WhatsApp Bot Configuration — Template
# Salin ke .env.dev untuk development atau .env.prod untuk production:
#   cp .env.example .env.dev
#   cp .env.example .env.prod
# Load otomatis berdasarkan NODE_ENV: dev/prod (default: dev)

# Bot Settings
PORT=3000

# Supervisor/Admin Configuration
# Nomor WhatsApp supervisor (bisa lebih dari satu, pisahkan dengan koma).
# Format: kode negara + nomor tanpa "+", contoh: 628123456789,628987654321
SUPERVISOR_PHONES=

# Environment (dev / prod)
NODE_ENV=dev
